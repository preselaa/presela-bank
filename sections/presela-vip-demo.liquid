{{ 'presela-vip-demo.css' | asset_url | stylesheet_tag }}
{% liquid
  assign has_vip_access = false
  if customer and customer.tags contains 'presela-vip-demo'
    assign has_vip_access = true
  endif
%}

<section class="ps-vip-hub" aria-labelledby="presela-vip-heading">
  <header class="ps-vip-hero">
    <p class="ps-vip-name">PRESELA VIP</p>
    <h1 id="presela-vip-heading">Your VIP benefits</h1>
    <p>Half-price shopping, free delivery, and order help in one place.</p>
    {% if has_vip_access %}
      <a class="button ps-vip-primary" href="{{ routes.all_products_collection_url }}">Browse the collection <span aria-hidden="true">→</span></a>
    {% elsif customer %}
      <p class="ps-vip-access-note">This account doesn’t have VIP access.</p>
    {% else %}
      <a class="button ps-vip-primary" href="{{ routes.storefront_login_url | escape }}">Sign in to VIP <span aria-hidden="true">→</span></a>
    {% endif %}
  </header>

  <div class="ps-vip-benefits">
    <article class="ps-vip-perk ps-vip-perk--primary">
      <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13 13 20a2 2 0 0 1-3 0l-6-6V4h10l6 6a2 2 0 0 1 0 3Z"/><circle cx="8" cy="8" r="1"/></svg></span>
      <h2>50% off every product</h2>
      <p>Member savings apply automatically to eligible orders at checkout.</p>
    </article>
    <article class="ps-vip-perk ps-vip-perk--primary">
      <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h12v11H3zM15 10h3l3 4v3h-6"/><circle cx="7" cy="18" r="2" fill="#fff"/><circle cx="18" cy="18" r="2" fill="#fff"/></svg></span>
      <h2>Free shipping</h2>
      <p>Free shipping on every eligible VIP order, with no order minimum.</p>
    </article>
    <article class="ps-vip-perk">
      <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M19 10c0 4.5-7 10-7 10S5 14.5 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
      <h2>Track your orders</h2>
      <p>Find order updates and carrier tracking as soon as it’s available.</p>
      <a href="{{ pages['track-order'].url }}">Track an order <span aria-hidden="true">→</span></a>
    </article>
    <article class="ps-vip-perk">
      <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-2a8 8 0 0 1 16 0v2M19 17c0 2-2 4-5 4h-2"/><rect x="3" y="12" width="4" height="6" rx="1"/><rect x="17" y="12" width="4" height="6" rx="1"/></svg></span>
      <h2>Order and membership help</h2>
      <p>Get help with sizing, delivery, returns, or your VIP access.</p>
      <a href="{{ pages['contact'].url }}">Contact Presela <span aria-hidden="true">→</span></a>
    </article>
  </div>
</section>

{% schema %}
{"name":"VIP benefits","settings":[]}
{% endschema %}
