{{ 'presela-vip-demo.css' | asset_url | stylesheet_tag }}

{% liquid
  assign has_vip_access = false
  if customer and customer.tags contains 'presela-vip-demo'
    assign has_vip_access = true
  endif
%}

<section class="ps-reviewer ps-vip-shop" aria-labelledby="presela-vip-heading">
  <header class="ps-reviewer-header">
    <p class="ps-reviewer-label">PRESELA VIP</p>
    <h1 id="presela-vip-heading">{{ page.title | escape }}</h1>
    {% if has_vip_access %}
      <p>Shop with 50% off your order. Your member discount applies automatically at checkout when you’re signed in.</p>
      <a class="button ps-reviewer-primary" href="#presela-vip-collection">Shop the collection</a>
    {% elsif customer %}
      <p>VIP shopping is available to approved accounts.</p>
    {% else %}
      <p>Sign in with the email linked to your VIP access to unlock member pricing.</p>
      <a class="button ps-reviewer-primary" href="{{ routes.storefront_login_url | escape }}">Sign in to VIP</a>
    {% endif %}
  </header>

  {% if has_vip_access %}
    <div class="ps-reviewer-body" id="presela-vip-collection">
      <h2>Shop member prices</h2>
      {% paginate collections.all.products by 36 %}
        <ul class="ps-reviewer-grid" role="list">
          {% for item in collections.all.products %}
            {% assign vip_price = item.price | times: 0.5 | round %}
            <li>
              <a class="ps-vip-shop-card" href="{{ item.url }}">
                {% if item.featured_image %}
                  {{ item.featured_image | image_url: width: 560 | image_tag: widths: '240,360,560', sizes: '(min-width: 700px) 28vw, 45vw', loading: 'lazy', alt: '' }}
                {% endif %}
                <div class="ps-reviewer-product">
                  <h3>{{ item.title | escape }}</h3>
                  <div class="ps-vip-price">
                    <strong>VIP {{ vip_price | money }}</strong>
                    <s>{{ item.price | money }}</s>
                  </div>
                  <span class="ps-vip-choice">{% if item.has_only_default_variant %}View product{% else %}Choose size{% endif %} <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </li>
          {% endfor %}
        </ul>
        {% if paginate.pages > 1 %}<div class="ps-vip-pagination">{{ paginate | default_pagination }}</div>{% endif %}
      {% endpaginate %}
    </div>
  {% endif %}
</section>

{% schema %}
{"name":"VIP shopping","settings":[]}
{% endschema %}
