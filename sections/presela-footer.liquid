<div class="ps-footer"><div class="ps-wrap ps-footer-grid"><div><a class="ps-brand" href="{{ routes.root_url }}">{% if settings.logo_inverse != blank %}{{ settings.logo_inverse | image_url: width: 320 | image_tag: widths: '160,240,320', loading: 'lazy', alt: shop.name }}{% elsif settings.logo != blank %}<span class="ps-logo">{{ settings.logo | image_url: width: 320 | image_tag: widths: '160,240,320', loading: 'lazy', alt: shop.name }}</span>{% else %}{{ shop.name | escape }}{% endif %}</a>{{ section.settings.about }}{% if section.settings.hours != blank %}<h3>Working hours</h3>{{ section.settings.hours }}{% endif %}</div><div><h3>{{ section.settings.shop_heading | escape }}</h3><ul role="list">{% for link in section.settings.shop_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div><div><h3>{{ section.settings.help_heading | escape }}</h3><ul role="list">{% for link in section.settings.help_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div><div><h3>Customer support email</h3>{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>{% endif %}{% if section.settings.address != blank %}<h3 class="ps-address-heading">Registered business address</h3>{{ section.settings.address }}{% endif %}</div></div><div class="ps-wrap ps-footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</span><nav aria-label="Store policies">{% if pages["subscription-policy"] != blank %}<a href="{{ pages["subscription-policy"].url }}">Subscription policy</a>{% endif %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav>{% if section.settings.show_payments and shop.enabled_payment_types.size > 0 %}<ul role="list" class="ps-payments">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}</div></div>
{% schema %}
{
  "name": "Presela footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "About",
      "default": "<p>Discover everyday favorites and explore Presela VIP.</p>"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help heading",
      "default": "Customer care"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Help menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "presela@atomicmail.io"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Registered business address",
      "default": "<p>30 N Gould St<br>Sheridan, WY 82801<br>United States</p>"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Working hours",
      "default": "<p>9 AM – 5 PM, Monday – Friday</p>"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show enabled payment icons",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Presela footer"
    }
  ]
}
{% endschema %}
