<div class="ps-footer ps-footer-compact">
  <div class="ps-wrap">
    <a class="ps-brand" href="{{ routes.root_url }}">{% if settings.logo_inverse != blank %}{{ settings.logo_inverse | image_url: width: 320 | image_tag: widths: '160,240,320', loading: 'lazy', alt: shop.name }}{% elsif settings.logo != blank %}<span class="ps-logo">{{ settings.logo | image_url: width: 320 | image_tag: widths: '160,240,320', loading: 'lazy', alt: shop.name }}</span>{% else %}{{ shop.name | escape }}{% endif %}</a>
    <div class="ps-footer-info">
      <div><h3>Working Hours</h3>{{ section.settings.hours }}</div>
      <div><h3>Business Address</h3>{{ section.settings.address }}</div>
      <div><h3>Customer Support Email</h3><a href="mailto:{{ shop.email | default: section.settings.email | escape }}">{{ shop.email | default: section.settings.email | escape }}</a><p><a href="{{ shop.refund_policy.url | default: section.settings.refund_link | default: '/pages/refund-policy' }}">{{ section.settings.guarantee | escape }}</a></p></div>
    </div>
    <div class="ps-footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</span>
      <nav aria-label="Store policies">
        {% if pages['track-order'].url != blank %}
          <a href="{{ pages['track-order'].url }}">Track Order</a>
        {% endif %}
        <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a>
        <a href="{{ shop.terms_of_service.url | default: section.settings.terms_link | default: '/pages/terms-of-service' }}">Terms of service</a>
        <a href="{{ shop.refund_policy.url | default: section.settings.refund_link | default: '/pages/refund-policy' }}">Refund policy</a>
        <a href="{{ shop.shipping_policy.url | default: section.settings.shipping_link | default: '/pages/shipping-policy' }}">Shipping policy</a>
        <a href="/pages/subscription-policy">Subscription policy</a>
        <a href="/pages/data-sharing-opt-out">Your Privacy Choices</a>
        <a href="/pages/cancel-membership">Cancel subscription</a>
        <a href="/pages/business-contact-information">Contact information</a>
      </nav>
      {% if section.settings.show_payments and shop.enabled_payment_types.size > 0 %}<ul role="list" class="ps-payments">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Presela footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "About",
      "default": "<p>Discover everyday favorites and explore Presela VIP.</p>"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help heading",
      "default": "Customer care"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Help menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "support@presela.com"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Registered business address",
      "default": "<p>30 N Gould St<br>Sheridan, WY 82801<br>United States</p>"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Working hours",
      "default": "<p>9 AM – 5 PM, Monday – Friday</p>"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show enabled payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee",
      "label": "Guarantee heading",
      "default": "30-day money-back guarantee"
    },
    {
      "type": "url",
      "id": "refund_link",
      "label": "Refund policy fallback link"
    },
    {
      "type": "url",
      "id": "shipping_link",
      "label": "Shipping policy fallback link"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms of service fallback link"
    }
  ],
  "presets": [
    {
      "name": "Presela footer"
    }
  ]
}
{% endschema %}
