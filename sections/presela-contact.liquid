<section class="psc" aria-labelledby="psc-heading-{{ section.id }}">
  <div class="psc-hero">
    <p>{{ section.settings.eyebrow | escape }}</p>
    <h1 id="psc-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    <div>{{ section.settings.intro }}</div>
  </div>
  <div class="psc-grid">
    <aside class="psc-info" aria-label="Customer support information">
      <h2>Get in touch</h2>
      <div class="psc-detail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><div><h3>Email us</h3><a href="mailto:{{ shop.email | escape }}">{{ shop.email | escape }}</a></div></div>
      <div class="psc-detail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><h3>Support hours</h3>{{ section.settings.hours }}</div></div>
      {% if section.settings.phone != blank %}<div class="psc-detail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h4l2 5-3 2a14 14 0 0 0 6 6l2-3 5 2v4c0 2-2 2-4 1C9 18 6 14 4 7 3 5 3 3 5 3Z"/></svg><div><h3>Call us</h3><a href="tel:{{ section.settings.phone | escape }}">{{ section.settings.phone | escape }}</a></div></div>{% endif %}
      {% if section.settings.address != blank %}<div class="psc-detail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><div><h3>Registered business address</h3>{{ section.settings.address }}</div></div>{% endif %}
      <div class="psc-links"><h3>Helpful links</h3><a href="{{ routes.account_url }}">View your orders <span aria-hidden="true">→</span></a><a href="/collections/vip-collection">VIP Collection <span aria-hidden="true">→</span></a><a href="/pages/cancel-membership">Cancel membership <span aria-hidden="true">→</span></a><a href="/pages/subscription-policy">Subscription policy <span aria-hidden="true">→</span></a><a href="/pages/shipping-policy">Shipping policy <span aria-hidden="true">→</span></a>{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Refund policy <span aria-hidden="true">→</span></a>{% endif %}</div>
    </aside>
    <div class="psc-form-card">
      <h2>{{ section.settings.form_heading | escape }}</h2>
      <p>{{ section.settings.form_intro | escape }}</p>
      {% assign contact_id = 'PreselaContact-' | append: section.id %}
      {% form 'contact', id: contact_id, class: 'psc-form' %}
        {% if form.posted_successfully? %}<p class="psc-success" role="status">Thank you. Your message has been submitted.</p>{% endif %}
        {% if form.errors %}<div class="psc-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="psc-row">
          <div><label for="{{ contact_id }}-name">Full name</label><input id="{{ contact_id }}-name" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required></div>
          <div><label for="{{ contact_id }}-email">Email address</label><input id="{{ contact_id }}-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required></div>
        </div>
        <div class="psc-row">
          <div><label for="{{ contact_id }}-topic">How can we help?</label><select id="{{ contact_id }}-topic" name="contact[Topic]" required><option value="">Choose a topic</option><option>Order or delivery</option><option>Returns or refunds</option><option>VIP membership or billing</option><option>Cancel membership</option><option>Product question</option><option>Other</option></select></div>
          <div><label for="{{ contact_id }}-order">Order number (optional)</label><input id="{{ contact_id }}-order" name="contact[Order number]" placeholder="e.g. #1001"></div>
        </div>
        <div><label for="{{ contact_id }}-message">Your message</label><textarea id="{{ contact_id }}-message" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea></div>
        <p class="psc-note">Please do not include passwords or full payment card details.</p>
        <button type="submit">{{ section.settings.button_text | escape }} <span aria-hidden="true">→</span></button>
      {% endform %}
    </div>
  </div>
</section>
<style>
.psc{max-width:1200px;margin:32px auto 64px;padding:0 24px;color:#102c69}.psc-hero{background:linear-gradient(130deg,#102c69,#214f98);border-radius:22px;padding:54px 28px;text-align:center;color:#fff}.psc-hero>p{color:#b6ddff;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin:0 0 12px}.psc-hero h1{color:#fff;font-size:clamp(32px,5vw,54px);line-height:1.1;margin:0 0 14px}.psc-hero div{color:#e4efff;font-size:17px;max-width:580px;margin:auto}.psc-hero div p{margin:0}.psc-grid{display:grid;grid-template-columns:minmax(0, .82fr) minmax(0,1.6fr);gap:24px;margin-top:24px}.psc-info,.psc-form-card{border:1px solid #dbe5f2;border-radius:18px;padding:30px;background:#fff;min-width:0}.psc-info{background:#f0f6ff}.psc h2{color:#102c69;font-size:25px;line-height:1.2;margin:0 0 20px}.psc h3{color:#102c69;font-size:15px;margin:0 0 5px}.psc-detail{display:flex;gap:13px;align-items:flex-start;padding:16px 0;border-bottom:1px solid #dbe5f2}.psc-detail svg{width:23px;height:23px;color:#214f98;flex:none}.psc-detail p,.psc-detail a{color:#465e7b;margin:0;overflow-wrap:anywhere;line-height:1.6}.psc-links{margin-top:23px}.psc-links a{display:flex;justify-content:space-between;gap:12px;color:#102c69;padding:10px 0;text-decoration:underline;text-underline-offset:3px}.psc-form-card>p{color:#465e7b;margin:-6px 0 24px}.psc-form{display:grid;gap:18px}.psc-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.psc-form label{display:block;font-size:14px;font-weight:600;margin-bottom:7px}.psc-form input,.psc-form select,.psc-form textarea{display:block;width:100%;border:1px solid #b6c7df;border-radius:9px;padding:12px;color:#102c69;background:#fff;font:inherit;min-height:48px;box-sizing:border-box}.psc-form textarea{resize:vertical}.psc-form button{border:0;border-radius:10px;background:#102c69;color:white;font:inherit;font-weight:700;min-height:52px;padding:14px 22px;display:flex;justify-content:space-between;align-items:center;cursor:pointer}.psc-form button:hover{background:#214f98}.psc-note{font-size:13px;color:#465e7b;margin:0}.psc-success,.psc-error{border:1px solid currentColor;border-radius:8px;padding:12px;margin:0}.psc-success{color:#17603e}.psc-error{color:#9b2727}.psc :is(a,button,input,select,textarea):focus-visible{outline:2px solid #214f98;outline-offset:3px}@media(max-width:749px){.psc{margin:20px auto 40px;padding:0 16px}.psc-hero{padding:36px 18px;border-radius:16px}.psc-grid{grid-template-columns:1fr;gap:16px;margin-top:16px}.psc-info,.psc-form-card{padding:22px}.psc-row{grid-template-columns:1fr;gap:18px}}
</style>
{% schema %}
{"name":"Presela contact","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRESELA CUSTOMER CARE"},{"type":"text","id":"heading","label":"Heading","default":"We're here to help."},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Questions about your order, delivery, returns or VIP membership? Get in touch with our customer care team.</p>"},{"type":"richtext","id":"hours","label":"Support hours","default":"<p>Monday–Friday<br>9 AM–5 PM</p>"},{"type":"text","id":"phone","label":"Support phone (verified number only)"},{"type":"richtext","id":"address","label":"Registered business address","default":"<p>30 N Gould St<br>Sheridan, WY 82801<br>United States</p>"},{"type":"text","id":"form_heading","label":"Form heading","default":"Send us a message"},{"type":"textarea","id":"form_intro","label":"Form introduction","default":"Tell us what you need help with. Include your order number if you have one."},{"type":"text","id":"button_text","label":"Button text","default":"Send message"}],"presets":[{"name":"Presela contact"}]}
{% endschema %}
