<section class="ps-wrap ps-hero"><div class="ps-hero-copy"><p class="ps-kicker">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1>{{ section.settings.copy }}<div class="ps-actions"><a class="button ps-light" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a><a class="ps-link" href="{{ section.settings.secondary_link | default: '/pages/vip-club' }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">→</span></a></div></div>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400,600,900,1200', sizes: '(min-width: 750px) 45vw, 100vw', class: 'ps-hero-image', loading: 'eager' }}{% else %}<div class="ps-art" aria-hidden="true"><svg viewBox="0 0 300 300" fill="none"><circle cx="150" cy="150" r="126" stroke="currentColor" opacity=".24"/><circle cx="150" cy="150" r="98" stroke="currentColor" opacity=".4"/><path d="M150 40 Q168 132 260 150 Q168 168 150 260 Q132 168 40 150 Q132 132 150 40Z" fill="currentColor"/><path d="M239 40 Q245 68 273 74 Q245 80 239 108 Q233 80 205 74 Q233 68 239 40Z" fill="currentColor" opacity=".65"/></svg></div>{% endif %}</section>
{% schema %}
{
  "name": "Presela hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WELCOME TO PRESELA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little more joy in every day."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Description",
      "default": "<p>Explore everyday favorites and discover the Presela VIP Club.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link",
      "default": "Explore VIP Club"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Presela hero"
    }
  ]
}
{% endschema %}
