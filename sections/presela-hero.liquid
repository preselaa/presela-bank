{% liquid
  assign shop_url = section.settings.primary_link | default: routes.all_products_collection_url
  assign vip_url = section.settings.secondary_link | default: pages['vip-club'].url
%}

<section class="ps-wrap ps-hero ps-editorial" aria-labelledby="presela-hero-{{ section.id }}">
  <div class="ps-editorial-copy">
    {% if section.settings.eyebrow != blank %}<p class="ps-editorial-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 id="presela-hero-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {{ section.settings.copy }}
    <div class="ps-editorial-actions">
      <a class="button ps-editorial-button" href="{{ shop_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>
      {% if vip_url != blank %}<a class="ps-editorial-secondary" href="{{ vip_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
    </div>
  </div>
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '420,620,850,1100,1400', sizes: '(min-width: 1250px) 660px, (min-width: 750px) 52vw, calc(100vw - 32px)', class: 'ps-editorial-image', loading: 'eager', fetchpriority: 'high' }}
  {% endif %}
</section>

<nav class="ps-wrap ps-shopping-services" aria-label="{{ section.settings.services_label | escape }}">
  {% if section.settings.shipping_label != blank and pages['shipping-policy'].url != blank %}
    <a href="{{ pages['shipping-policy'].url }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h12v12H3zM15 9h3l3 4v4h-6"/><circle cx="7" cy="18" r="2" fill="white"/><circle cx="18" cy="18" r="2" fill="white"/></svg>
      <span>{{ section.settings.shipping_label | escape }}</span>
    </a>
  {% endif %}
  {% if section.settings.refund_label != blank and pages['refund-policy'].url != blank %}
    <a href="{{ pages['refund-policy'].url }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9a8 8 0 1 1 1 9M5 4v5h5"/><path d="m10 12.5 2 2 4-4"/></svg>
      <span>{{ section.settings.refund_label | escape }}</span>
    </a>
  {% endif %}
  {% if section.settings.tracking_label != blank and pages['track-order'].url != blank %}
    <a href="{{ pages['track-order'].url }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 10c0 4.5-7 10-7 10S5 14.5 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <span>{{ section.settings.tracking_label | escape }}</span>
    </a>
  {% endif %}
</nav>
{% schema %}
{
  "name": "Presela hero",
  "settings": [
    { "type": "text", "id": "services_label", "label": "Services navigation label", "default": "Shopping support" },
    { "type": "text", "id": "shipping_label", "label": "Shipping policy link", "default": "Ships within 72 hours" },
    { "type": "text", "id": "refund_label", "label": "Refund policy link", "default": "30-day returns" },
    { "type": "text", "id": "tracking_label", "label": "Order tracking link", "default": "Track your order" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WELCOME TO PRESELA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little more joy in every day."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Description",
      "default": "<p>Explore everyday favorites and discover the Presela VIP Club.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link",
      "default": "Explore VIP Club"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Presela hero"
    }
  ]
}
{% endschema %}
