{%- doc -%}
  Displays accepted payment method icons instead of accelerated checkout.
  @param {string} can_add_to_cart - Whether the product can be added to cart
  @param form_obj - Product form
{%- enddoc -%}
{% if shop.enabled_payment_types.size > 0 %}
  <div class="ps-product-payment-block" {{ block.shopify_attributes }}>
    <ul class="ps-product-payment-icons" role="list" aria-label="Accepted payment methods">
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
{% render 'buy-buttons-styles' %}
{% schema %}
{"name":"Payment method icons","tag":null}
{% endschema %}
