{% assign membership_email = 'presela@atomicmail.io' %}
<section class="ps-member-shell">
  {% if page.handle == 'vip-club' %}
    {% assign membership_product = all_products['presela-vip-membership'] %}
    {% assign membership_variant = membership_product.selected_or_first_available_variant %}
    {% assign membership_plan = membership_variant.selling_plan_allocations.first %}
    <div class="ps-member-hero ps-member-hero--join">
      <span class="ps-member-symbol" aria-hidden="true">✦</span>
      <p class="ps-member-kicker">THE PRESELA VIP CLUB</p>
      <h1>Why become a member?</h1>
      <p>Discover exclusive member savings, special offers and a better way to shop Presela.</p>
      <div class="ps-member-price"><strong>$29.99</strong><span>every 28 days</span></div>
      <p class="ps-member-renewal">Optional membership. Automatically renews every 28 days until canceled.</p>
      <div class="ps-member-ctas">
        {% if membership_variant.available and membership_plan != blank %}
          <script type="module" src="{{ 'product-form.js' | asset_url }}"></script>
          <product-form-component data-product-id="{{ membership_product.id }}" data-quantity-default="1" on:submit="/handleSubmit">
            {% form 'product', membership_product %}
              <input type="hidden" name="id" ref="variantId" value="{{ membership_variant.id }}">
              <input type="hidden" name="selling_plan" value="{{ membership_plan.selling_plan.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="ps-member-primary ps-member-join">Join &amp; Save <span aria-hidden="true">→</span></button>
              <span ref="liveRegion" class="visually-hidden" aria-live="polite"></span>
              <span ref="addToCartTextError" class="hidden ps-member-form-error" role="alert"></span>
            {% endform %}
          </product-form-component>
        {% else %}
          <button type="button" class="ps-member-primary ps-member-join" disabled>Join &amp; Save <span aria-hidden="true">→</span></button>
        {% endif %}
        <a class="ps-member-primary ps-member-existing" href="/collections/vip-collection">Existing Member? Click Here <span aria-hidden="true">→</span></a>
      </div>
      <p class="ps-member-renewal ps-member-signin-note">Already a member? Verify your email to access your benefits.</p>
    </div>
    <div class="ps-member-body">
      <h2>Membership benefits</h2>
      <div class="ps-member-grid">
        <div class="ps-member-feature"><span class="ps-member-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 19 19 5"/><circle cx="7.5" cy="7.5" r="3"/><circle cx="16.5" cy="16.5" r="3"/></svg></span><div><h3>50% off eligible products</h3><p>Enjoy 50% off eligible VIP Collection products with your active membership. Your discount is applied automatically at checkout.</p></div></div>
        <div class="ps-member-feature"><span class="ps-member-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h18v4H3zM5 12h14v9H5zM12 8v13M12 8C4 8 5 1 9 3c2 1 3 5 3 5Zm0 0c8 0 7-7 3-5-2 1-3 5-3 5Z"/></svg></span><div><h3>Exclusive member deals</h3><p>Discover special offers for active VIP members.</p></div></div>
        <div class="ps-member-feature"><span class="ps-member-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 5v2"/></svg></span><div><h3>Member-only access</h3><p>Sign in securely with your membership email.</p></div></div>
      </div>
      <nav class="ps-member-links" aria-label="Membership resources"><a href="/collections/vip-collection">VIP Collection</a><a href="/pages/cancel-membership">Cancel membership</a><a href="/pages/subscription-policy">Subscription policy</a></nav>
      <section class="ps-member-faq" aria-labelledby="ps-vip-faq-title">
        <p class="ps-member-section-kicker">MEMBERSHIP HELP</p>
        <h2 id="ps-vip-faq-title">Frequently asked questions</h2>
        <details><summary>How do I join?</summary><p>Choose Join &amp; Save, review the membership terms and complete checkout when enrollment is open. Use the email associated with your membership to sign in and access your VIP benefits.</p></details>
        <details><summary>Is the membership fee a recurring charge?</summary><p>Yes. Presela VIP costs $29.99 USD every 28 days and automatically renews until canceled. Membership is optional.</p></details>
        <details><summary>How do I access my VIP benefits?</summary><p>Select Existing Member? Click Here and verify your membership email. Active members can access the <a href="/collections/vip-collection">VIP Collection</a>.</p></details>
        <details><summary>How do I cancel my membership?</summary><p>You can cancel at any time before your next renewal. Use the <a href="/pages/cancel-membership">cancellation page</a>, submit the form below or email <a href="mailto:{{ membership_email }}">{{ membership_email }}</a>. No survey or additional purchase is required. We will confirm cancellation.</p></details>
      </section>
      <section class="ps-member-cancel" id="vip-cancel" aria-labelledby="ps-vip-cancel-title">
        <p class="ps-member-section-kicker">MEMBERSHIP SUPPORT</p>
        <h2 id="ps-vip-cancel-title">Want to cancel your membership?</h2>
        <p>Send us your request using your membership email. Our support team will confirm your cancellation.</p>
        {% form 'contact', id: 'PreselaVipCancellation', class: 'ps-member-cancel-form' %}
          {% if form.posted_successfully? %}<p class="ps-member-status" role="status">Your cancellation request has been submitted. We will send confirmation by email.</p>{% endif %}
          {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <input type="hidden" name="contact[Request type]" value="VIP membership cancellation">
          <label for="VipCancelName">Name</label>
          <input id="VipCancelName" name="contact[name]" autocomplete="name" value="{{ customer.name | escape }}">
          <label for="VipCancelEmail">Membership email <span aria-hidden="true">*</span></label>
          <input id="VipCancelEmail" type="email" name="contact[email]" autocomplete="email" value="{{ customer.email | escape }}" required>
          <label for="VipCancelOrder">Order number (optional)</label>
          <input id="VipCancelOrder" name="contact[Order number]">
          <label for="VipCancelMessage">Message (optional)</label>
          <textarea id="VipCancelMessage" name="contact[body]" rows="4">Please cancel my Presela VIP membership.</textarea>
          <button type="submit" class="ps-member-cancel-submit">Send cancellation request <span aria-hidden="true">→</span></button>
        {% endform %}
        <p class="ps-member-cancel-alt">You can also email <a href="mailto:{{ membership_email }}?subject=Cancel%20my%20VIP%20membership">{{ membership_email }}</a>. Please do not include card details.</p>
      </section>
    </div>
  {% elsif page.handle == 'vip-collection' %}
    <div class="ps-member-hero ps-member-compact">
      <span class="ps-member-symbol" aria-hidden="true">✦</span>
      <p class="ps-member-kicker">YOUR PRESELA ACCOUNT</p>
      <h1>{{ page.title | escape }}</h1>
      <p>Sign in to access your exclusive member-only collection.</p>
    </div>
    <div class="ps-member-body">
      <h2>Access your VIP collection</h2>
      {% if customer %}
        {% if customer.tags contains 'presela-vip-active' %}<p class="ps-member-status">Active VIP membership</p>{% else %}<p>No active VIP access is associated with this account.</p>{% endif %}
        <a class="ps-member-action" href="{{ routes.account_url }}">Open customer account <span aria-hidden="true">→</span></a>
      {% else %}
        <p>Sign in with the email you used to purchase your membership.</p>
        <a class="ps-member-action" href="{{ routes.account_login_url }}">Verify email &amp; sign in <span aria-hidden="true">→</span></a>
      {% endif %}
      <a class="ps-member-action ps-member-outline" href="/collections/vip-collection">Access VIP Collection <span aria-hidden="true">→</span></a>
      <nav class="ps-member-links" aria-label="Membership resources"><a href="/pages/cancel-membership">Cancel membership</a><a href="/pages/subscription-policy">Subscription policy</a></nav>
    </div>
  {% else %}
    <div class="ps-member-hero ps-member-compact">
      <span class="ps-member-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="m8 12 2.5 2.5L16 9"/></svg></span>
      <p class="ps-member-kicker">MEMBERSHIP SUPPORT</p>
      <h1>Cancel membership</h1>
      <p>Cancel future renewals at any time. No survey or additional purchase required.</p>
    </div>
    <div class="ps-member-body">
      <h2>Cancel your VIP subscription</h2>
      <p>Your membership renews at $29.99 every 28 days. Cancel before the next renewal to avoid another charge.</p>
      <a class="ps-member-action" href="mailto:{{ membership_email }}?subject=Cancel%20my%20VIP%20membership&amp;body=Please%20cancel%20my%20Presela%20VIP%20membership.%0AMembership%20email%3A%20">Request cancellation by email <span aria-hidden="true">→</span></a>
      <p class="ps-member-small">Send the email from your membership address. We will confirm cancellation. Do not include payment card details.</p>
      <a class="ps-member-action ps-member-outline" href="{{ routes.account_url }}">Manage subscription in your account <span aria-hidden="true">→</span></a>
      <nav class="ps-member-links" aria-label="Membership resources"><a href="/pages/subscription-policy">Subscription policy</a><a href="/pages/contact">Contact support</a></nav>
    </div>
  {% endif %}
</section>
