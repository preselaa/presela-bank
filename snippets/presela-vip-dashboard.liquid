{% if customer and customer.tags contains 'presela-vip-active' %}
  {{ 'presela-vip-demo.css' | asset_url | stylesheet_tag }}
  <section class="ps-vip-hub ps-vip-dashboard" aria-labelledby="ps-vip-dashboard-title">
    <header class="ps-vip-dashboard-hero">
      <p class="ps-vip-name">PRESELA VIP</p>
      <h1 id="ps-vip-dashboard-title">Your VIP benefits</h1>
      <p>Half-price shopping, free delivery and order help in one place.</p>
      <a class="ps-vip-primary" href="#ps-vip-exclusives">Browse the collection <span aria-hidden="true">→</span></a>
    </header>
    <div class="ps-vip-benefits ps-vip-dashboard-benefits">
      <article class="ps-vip-perk ps-vip-perk--primary">
        <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 13 13 20a2 2 0 0 1-3 0l-6-6V4h10l6 6a2 2 0 0 1 0 3Z"/><circle cx="8" cy="8" r="1"/></svg></span>
        <h3>50% off every product</h3><p>Enjoy half-price merchandise with your active VIP membership.</p>
      </article>
      <article class="ps-vip-perk ps-vip-perk--primary">
        <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h12v11H3zM15 10h3l4 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
        <h3>Free shipping</h3><p>Free standard shipping on every VIP merchandise order, with no minimum spend.</p>
      </article>
      <article class="ps-vip-perk">
        <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
        <h3>Track your orders</h3><p>Find order updates and carrier tracking as soon as available.</p><a href="/pages/track-order">Track an order →</a>
      </article>
      <article class="ps-vip-perk">
        <span class="ps-perk-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 13v-2a8 8 0 0 1 16 0v2M19 17c0 2-2 4-5 4h-2"/><rect x="3" y="12" width="4" height="6" rx="1"/><rect x="17" y="12" width="4" height="6" rx="1"/></svg></span>
        <h3>Order and membership help</h3><p>Get help with sizing, delivery, returns or your VIP access.</p><a href="/pages/contact">Contact Presela →</a>
      </article>
    </div>
    <div id="ps-vip-exclusives">{% render 'presela-exclusive-grid' %}</div>
    {% render 'presela-vip-regular-grid' %}
  </section>
{% endif %}
