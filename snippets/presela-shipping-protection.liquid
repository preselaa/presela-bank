{% liquid
  assign protection = settings.presela_protection_product
  if protection != blank
    assign protection_variant = protection.selected_or_first_available_variant
    assign protection_added = false
    assign physical_items = false
    for item in cart.items
      if item.product.id == protection.id
        assign protection_added = true
      elsif item.requires_shipping
        assign physical_items = true
      endif
    endfor
  endif
%}
<div data-hydration-key="presela-shipping-protection">
{% if protection_variant.available and physical_items %}
  <div class="ps-protection">
    <div class="ps-protection-info">
      {% if protection.featured_image %}{{ protection.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48,96', alt: '' }}{% else %}
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3 4 6v5c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-3Z"/><path d="m8 12 2.5 2.5L16 9"/></svg>
      {% endif %}
      <div><strong>Shipping protection</strong><p>{{ settings.presela_protection_description | escape }}</p><span>{{ protection_variant.price | money }}</span></div>
    </div>
    {% if protection_added %}
      <p class="ps-protection-added">Added · Remove from cart anytime</p>
    {% else %}
      <form action="{{ routes.cart_add_url }}" method="post" data-ps-protection-form>
        <input type="hidden" name="id" value="{{ protection_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="button button-secondary" type="submit">Add protection</button>
        <p data-ps-protection-error role="alert"></p>
      </form>
    {% endif %}
  </div>
{% endif %}
</div>
